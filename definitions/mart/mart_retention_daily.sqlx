config {
    type: "table",
    schema: "analytics_mart",
    name: "mart_retention_daily",
    bigquery: {
        partitionBy: "cohort_date",
        clusterBy: ["country", "os"]
    },
    assertions: {
        nonNull: ["cohort_date", "day_n", "country", "os"]
    },
    description: "Retention Matrix long format D0–D30 — Looker Studio heatmap-ready",
    columns: {
        cohort_date:    "Date of user's first_open",
        day_n:          "Days since cohort_date (0–30)",
        country:        "User country",
        os:             "Operating system",
        cohort_size:    "Number of users in this cohort",
        retained_users: "Users active on exactly day_n — NULL if cohort not yet mature",
        retention_pct:  "retained_users / cohort_size — NULL if cohort not yet mature"
    }
}

WITH
  cohort_profiles AS (
    SELECT cohort_date, country, os, user_pseudo_id
    FROM ${ref("int_retention_kpis")}
  ),
  cohort_sizes AS (
    SELECT
      cohort_date,
      country,
      os,
      COUNT(DISTINCT user_pseudo_id) AS cohort_size
    FROM cohort_profiles
    GROUP BY 1, 2, 3
  ),
  day_series AS (
    SELECT day_n
    FROM UNNEST(GENERATE_ARRAY(0, 30)) AS day_n
  ),
  matrix_grid AS (
    SELECT cs.cohort_date, ds.day_n, cs.country, cs.os, cs.cohort_size
    FROM cohort_sizes cs
    CROSS JOIN day_series ds
  ),
  actual_retained_counts AS (
    SELECT
      cb.cohort_date,
      DATE_DIFF(ce.event_date, cb.cohort_date, DAY) AS day_n,
      cb.country,
      cb.os,
      COUNT(DISTINCT ce.user_pseudo_id)              AS retained_users
    FROM ${ref("stg_core_events")} ce
    INNER JOIN ${ref("int_retention_kpis")} cb
      ON ce.user_pseudo_id = cb.user_pseudo_id
    WHERE DATE_DIFF(ce.event_date, cb.cohort_date, DAY) BETWEEN 0 AND 30
    GROUP BY 1, 2, 3, 4
  )
SELECT
  SAFE_CAST(g.cohort_date AS DATE)  AS cohort_date,
  SAFE_CAST(g.day_n AS INT64)       AS day_n,
  g.country,
  g.os,
  SAFE_CAST(g.cohort_size AS INT64) AS cohort_size,
  IF(
    DATE_DIFF(CURRENT_DATE('${dataform.projectConfig.vars.timezone}'), g.cohort_date, DAY) < g.day_n,
    NULL,
    SAFE_CAST(COALESCE(r.retained_users, 0) AS INT64)
  )                                 AS retained_users,
  IF(
    DATE_DIFF(CURRENT_DATE('${dataform.projectConfig.vars.timezone}'), g.cohort_date, DAY) < g.day_n,
    NULL,
    SAFE_CAST(SAFE_DIVIDE(COALESCE(r.retained_users, 0), NULLIF(g.cohort_size, 0)) AS FLOAT64)
  )                                 AS retention_pct
FROM matrix_grid g
LEFT JOIN actual_retained_counts r
  ON  g.cohort_date = r.cohort_date
  AND g.day_n       = r.day_n
  AND g.country     = r.country
  AND g.os          = r.os
